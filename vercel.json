{
  "version": 2,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.js" }],
  "crons": [
    {
      "path": "/api/cron/scheduled-posts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/recordings-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/presence-gc",
      "schedule": "* * * * *"
    }
  ]
}
