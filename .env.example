PORT=5000
MONGO_URI=mongodb://localhost:27017/quantummeet
CLIENT_URL=http://localhost:3000

# Optional comma-separated extra CORS origins (custom domains, etc.)
EXTRA_ALLOWED_ORIGINS=

# JWT (classroom auth) + room host tokens
JWT_SECRET=
ROOM_TOKEN_SECRET=

# Vercel Cron auth for /api/cron/*
CRON_SECRET=

# Optional Sentry
# SENTRY_DSN=

# STUN/TURN for clients via GET /api/ice (JSON array). Prefer server-side TURN.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]

# MONGO_MAX_POOL=2
# FEATURE_ORGS=1
# FEATURE_SSO=1
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_MOCK=1
# Mesh soft-cap (warn UI only — media stays WebRTC P2P on Vercel)
# MESH_SOFT_CAP=10
# PARTNER_RATE_MAX=60
# ATLAS_PRIMARY_REGION=us-east-1
# ATLAS_SECONDARY_REGIONS=
# QM_REGION=
# RECORDING_RETENTION_DAYS=30
# COST_ATLAS_USD=
# COST_VERCEL_USD=
# COST_TURN_USD=
# COST_BLOB_USD=
# COST_MAU=
# PILOT_SEAT_USD=5
# LTI_ENABLED=0
# LTI_PUBLIC_JWK=
# ATTENDANCE_ACCURACY_TARGET=90

# Vercel Blob (classroom file uploads — set automatically by Vercel when
# Blob storage is enabled on the project; only needed manually for local dev)
BLOB_READ_WRITE_TOKEN=
